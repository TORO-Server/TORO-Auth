# 必須 (秘密)
# セッションの署名鍵。32 バイト以上 (openssl rand -hex 32)。変えると全員がログアウトされ、発行済みのトークンも使えなくなる
JWT_SECRET=
# Discord アプリの Client Secret
DISCORD_CLIENT_SECRET=
# TORO-Server/TORO-Wiki の Contents を読み書きできるトークン (Fine-grained PAT。対象はこのリポジトリだけにする)
GITHUB_TOKEN=

# 任意 (秘密)。無ければ利用者のトークン (guilds.members.read) でロールを調べる
# DISCORD_BOT_TOKEN=

# 任意。既定は本番の値
# DISCORD_REQUIRED_ROLE_ID=
# DISCORD_CLIENT_ID=0000000000000000000
# DISCORD_GUILD_ID=000000000000000000
# DISCORD_REDIRECT_URI=https://auth.torosaba.net/api/auth/callback
# GITHUB_OWNER=TORO-Server
# GITHUB_REPO=TORO-Wiki
# GITHUB_BRANCH=main
# COOKIE_DOMAIN=.torosaba.net
# PUBLIC_AUTH_URL=https://auth.torosaba.net
# PUBLIC_MCP_URL=https://mcp.torosaba.net
# MC_STATUS_ADDR=toro-velocity:25565
# MC_STATUS_HOST=torosaba.net
# PORT=8080
