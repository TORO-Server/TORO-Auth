# 必須 (秘密)
# 署名の鍵。トークンの種類ごとに別の値にする (どれも 32 バイト以上で、互いに違う値。openssl rand -hex 32 を種類の数だけ)。
# 1 つが漏れても、他の種類のトークンは偽造できない。変えると、その種類のトークンだけが使えなくなる
JWT_SECRET_SESSION=
JWT_SECRET_CONNECTOR=
JWT_SECRET_ACCESS=
JWT_SECRET_REFRESH=
JWT_SECRET_CODE=
JWT_SECRET_CONSENT=
JWT_SECRET_STATE=
# Discord アプリの Client Secret
DISCORD_CLIENT_SECRET=
# Discord アプリの Client ID と、対象ギルドの ID (リポジトリには実値を書かない)
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# 任意 (秘密)。無ければ利用者のトークン (guilds.members.read) でロールを調べる
# ギルドに入っている Bot のトークン。あれば確認の窓口がいまのロールと編集権限を返し、auth の画面にロールの名前を出す
# (無ければ、ロールと編集権限はトークンの発行時のままで、画面のロールは ID)
# DISCORD_BOT_TOKEN=

# 任意 (秘密)。内側のポートの `/introspect` を呼ぶ側 (api / mcp) と共有する秘密。32 バイト以上。
# 設定すると、呼び出しは `X-Toro-Token` に同じ値を付けなければ 401 になる。呼び出し側へ先に渡してから設定する
# INTROSPECT_SECRET=

# 任意。Wiki の編集を許すロール。無ければギルドの全員が編集できる
# DISCORD_REQUIRED_ROLE_ID=

# 任意。既定は本番の値
# DISCORD_REDIRECT_URI=https://auth.torosaba.net/callback
# Cookie 付きで API を呼べる Origin (カンマ区切り)
# CORS_ORIGINS=https://wiki.torosaba.net
# PUBLIC_AUTH_URL=https://auth.torosaba.net
# PUBLIC_WIKI_URL=https://wiki.torosaba.net
# PORT=8080
# api / mcp のトークンの確認を受ける内側のポート。トンネルにもホストにも公開しない
# INTERNAL_PORT=8081
# 90 日トークンの世代、ブラウザのセッションの世代 (ログアウトで進める)、OAuth の連携の記録を置く場所 (書き込めて、再起動しても残る場所)
# STATE_DIR=/data
# OAuth の連携を、使わないまま置いてよい日数。過ぎると、トークンが通らなくなる (使っている間は続く)
# OAUTH_IDLE_DAYS=30
