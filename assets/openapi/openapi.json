{
  "openapi": "3.1.0",
  "info": {
    "title": "TORO Server Wiki & Auth API",
    "version": "1.0.0",
    "description": "TORO Server 共通認証基盤および Wiki ドキュメント編集 API。Discord OAuth2 で認証した Bearer トークンを用いてドキュメントの読み取り・コミットが可能です。ChatGPT Actions や Gemini Extensions から利用できます。",
    "contact": {
      "name": "TORO Server Administration",
      "url": "https://wiki.torosaba.net"
    }
  },
  "servers": [
    {
      "url": "{{SERVER_URL}}",
      "description": "TORO Server Auth Gateway"
    }
  ],
  "paths": {
    "/api/docs/raw": {
      "get": {
        "summary": "Wiki ドキュメントの Markdown 原稿取得",
        "operationId": "getWikiDocRaw",
        "description": "GitHub リポジトリ上の指定されたパスの Markdown 本文および SHA ハッシュを取得します。",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ドキュメントの相対パス（例: \"07_System/Discord認証編集とAIコネクタ.md\"）"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "raw"
              ]
            },
            "description": "返却フォーマット。raw を指定すると text/markdown 本文のみを返します。"
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "sha": {
                      "type": "string"
                    },
                    "content": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer"
                    }
                  }
                }
              },
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "指定されたファイルが存在しません"
          }
        }
      }
    },
    "/api/docs/save": {
      "post": {
        "summary": "Wiki ドキュメントの保存・GitHub コミット",
        "operationId": "saveWikiDoc",
        "description": "Discord 認証情報を用いて GitHub リポジトリへ直接コミットを行います。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "path",
                  "content"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "description": "保存先のドキュメントパス"
                  },
                  "content": {
                    "type": "string",
                    "description": "保存する Markdown 本文全体"
                  },
                  "message": {
                    "type": "string",
                    "description": "Git コミットメッセージ"
                  },
                  "sha": {
                    "type": "string",
                    "description": "既存ファイルの SHA ハッシュ（省略可）"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "保存成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "path": {
                      "type": "string"
                    },
                    "commitSha": {
                      "type": "string"
                    },
                    "contentSha": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Discord 認証トークンが必要です"
          },
          "403": {
            "description": "Wiki 編集権限がありません"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "現在の認証ユーザー情報取得",
        "operationId": "getAuthMe",
        "description": "Bearer トークンまたは Cookie に基づく現在のユーザープロフィールと権限情報を返します。",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "認証ステータス",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "authenticated": {
                      "type": "boolean"
                    },
                    "user": {
                      "type": "object",
                      "nullable": true,
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "username": {
                          "type": "string"
                        },
                        "global_name": {
                          "type": "string",
                          "nullable": true
                        },
                        "avatar_url": {
                          "type": "string"
                        },
                        "can_edit": {
                          "type": "boolean"
                        },
                        "roles": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Discord OAuth2 認証で取得した Bearer トークン"
      }
    }
  }
}
